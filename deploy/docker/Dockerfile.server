# syntax=docker/dockerfile:1
# wa-mcp server: Python slim, dependencies from uv.lock, non-root user 65532 (the same user as the
# bridge, so both read the shared store volume). Build from the repository root:
#   docker build -f deploy/docker/Dockerfile.server -t wa-mcp-server .
# Voice notes need ffmpeg: add --build-arg WITH_FFMPEG=true.

ARG PYTHON_VERSION=3.13
ARG UV_VERSION=0.13.7

FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv

FROM python:${PYTHON_VERSION}-slim-bookworm AS build
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/app/.venv
WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY sdk/python/pyproject.toml sdk/python/pyproject.toml
COPY server/pyproject.toml server/pyproject.toml
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-dev --no-install-workspace
COPY sdk/python/wa_mcp sdk/python/wa_mcp
COPY sdk/python/hatch_build.py sdk/python/hatch_build.py
COPY prompts/agent-default.md prompts/agent-default.md
COPY server/wa_mcp_server server/wa_mcp_server
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-dev --no-editable

FROM python:${PYTHON_VERSION}-slim-bookworm
LABEL io.modelcontextprotocol.server.name="io.github.tsahospital-beep/wa-mcp"
ARG WITH_FFMPEG=false
# hadolint ignore=DL3008
RUN groupadd --system --gid 65532 nonroot \
    && useradd --system --uid 65532 --gid 65532 --home-dir /data --no-create-home --shell /usr/sbin/nologin nonroot \
    && mkdir -p /data/store /data/downloads /data/exports \
    && chown -R 65532:65532 /data \
    && if [ "$WITH_FFMPEG" = "true" ]; then \
        apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*; \
    fi
COPY --from=build /app/.venv /app/.venv
COPY deploy/docker/config.container.json /config/config.json
ENV PATH=/app/.venv/bin:$PATH \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/data \
    WA_MCP_CONFIG=/config/config.json
USER 65532:65532
VOLUME ["/data"]
EXPOSE 8765
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD ["wa-mcp", "health"]
ENTRYPOINT ["wa-mcp"]
CMD ["serve", "--http"]
