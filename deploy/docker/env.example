# Copy to .env next to compose.yaml and keep it readable only by you: cp env.example .env && chmod 600 .env
# Then make the database key (sh secrets/make-key.sh) and start: docker compose --profile caddy up -d --build

# Domain that points to this server (an A or AAAA record). Caddy gets the certificate for it.
WA_MCP_DOMAIN=wa.example.com

# Time zone of both containers: quiet hours, scheduled messages and my_day use it.
TZ=UTC

# Host port of the MCP server on 127.0.0.1 (for an SSH tunnel or a proxy on the host). Empty = random.
WA_MCP_PORT=8765

# Encryption of wa.db. keyfile (the default) reads the Docker secret secrets/wa_mcp.key, made by
# secrets/make-key.sh; keep a copy of that file outside the server, there is no recovery without it.
WA_MCP_ENCRYPTION_MODE=keyfile
# Only for WA_MCP_ENCRYPTION_MODE=passphrase: the passphrase, or a file with it (mode 0600, user 65532).
WA_MCP_PASSPHRASE=
WA_MCP_PASSPHRASE_FILE=

# Admin password for the OAuth consent page, used when server.oauth.approval is "password".
# With the default "link" approval, approval links appear in: docker compose logs server
WA_MCP_ADMIN_PASSWORD=

# whatsmeow log level of the bridge: ERROR, WARN, INFO, DEBUG
WA_MCP_LOG_LEVEL=WARN
