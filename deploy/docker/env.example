# Copy to .env next to compose.yaml. Keep .env readable only by you (chmod 600 .env).

# Domain that points to this server (an A or AAAA record). Caddy gets the certificate for it.
WA_MCP_DOMAIN=wa.example.com

# Host port of the MCP server on 127.0.0.1 (for an SSH tunnel or your own proxy). Empty = random.
WA_MCP_PORT=8765

# Admin password for the OAuth consent page, used when server.oauth.approval is "password".
# With the default "link" approval, approval links appear in: docker compose logs server
WA_MCP_ADMIN_PASSWORD=

# Encryption of wa.db. A server has no OS keystore, so the default here is the passphrase mode.
# Make one with: openssl rand -hex 32   (there is no recovery without it)
WA_MCP_ENCRYPTION_MODE=passphrase
WA_MCP_PASSPHRASE=
# Or a key file instead: WA_MCP_ENCRYPTION_MODE=keyfile and the path inside the containers here.
WA_MCP_KEY_FILE=

# whatsmeow log level of the bridge: ERROR, WARN, INFO, DEBUG
WA_MCP_LOG_LEVEL=WARN
